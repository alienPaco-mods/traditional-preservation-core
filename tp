#!/usr/bin/env python3
"""Development tool for the Traditional Preservation mods (and FuelBarrel).

  tp status                     every mod: git, installed copy, guide copy
  tp test [MOD...]              run each mod's tests, then its golden checks (with no MOD, the core's too)
  tp golden [MOD...] [--update] compare the season and simulation tools with their recorded output
  tp install MOD [--force] [--skip-tests]
                                test, then copy the mod to ~/Zomboid/mods. Refuses if the installed copy has
                                edits newer than the source, or files the source doesn't have (--force overrides)
  tp guides [--force]           copy guides/ into the mods and rebuild the collection zip
  tp sync [MOD...] [--force]    copy the shared core (lua/) into each mod under its own path. With no MOD, the mods
                                that already have it. Refuses to overwrite a copy edited by hand (--force overrides)
  tp new Name [--station "Two Words"] [--short TPX]
                                a new mod TraditionalPreservation<Name> from template/: core synced, art built, golden
                                season report recorded, guide stub in guides/, git initialised, tests run

MOD is a folder name or its short form: Salt, Fish, Yeast, Vinegar, SaltLTP, FuelBarrel.
"""
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import zipfile
from pathlib import Path

MODS = Path(os.environ.get("TP_MODS", Path.home() / "MODS"))  # tests point it elsewhere
CORE = Path(__file__).resolve().parent
INSTALLED = Path(os.environ.get("TP_INSTALLED", Path.home() / "Zomboid" / "mods"))  # tests point it elsewhere
GUIDES = MODS / "guides"
COLLECTION = GUIDES / "TraditionalPreservationCollectionGuides"
GOLDEN = CORE / "golden"
GOLDEN_CONFIG = GOLDEN / "golden.json"
PREFIX = "TraditionalPreservation"
# Never shipped: version control and Python caches.
SKIP_NAMES = {".git", "__pycache__", ".gitignore"}
SKIP_SUFFIXES = {".pyc"}


def all_mods():
    """Every folder in ~/MODS with a 42/mod.info, except old copies and tooling."""
    return sorted(p.name for p in MODS.iterdir()
                  if p.is_dir() and (p / "42" / "mod.info").exists()
                  and not p.name.startswith("_") and not p.name.endswith("-old"))


def resolve(names):
    mods = all_mods()
    if not names:
        return mods
    found = []
    for name in names:
        for candidate in (name, PREFIX + name):
            if candidate in mods:
                found.append(candidate)
                break
        else:
            sys.exit(f"tp: no mod called {name}. Known: {', '.join(short(m) for m in mods)}")
    return found


def short(mod):
    return mod[len(PREFIX):] if mod.startswith(PREFIX) and mod != PREFIX else mod


def shipped_files(root):
    """Relative paths of the files that belong in an installed copy."""
    files = {}
    for path in root.rglob("*"):
        rel = path.relative_to(root)
        if any(part in SKIP_NAMES for part in rel.parts) or path.suffix in SKIP_SUFFIXES or not path.is_file():
            continue
        files[rel] = path
    return files


def compare_install(mod):
    """What differs between the source and the installed copy: (differ, newer_installed, only_installed, missing)."""
    source = shipped_files(MODS / mod)
    target_root = INSTALLED / mod
    if not target_root.exists():
        return None
    target = shipped_files(target_root)
    differ, newer, extra = [], [], []
    for rel, path in source.items():
        other = target.get(rel)
        if other is None:
            differ.append(rel)
        elif path.read_bytes() != other.read_bytes():
            differ.append(rel)
            if other.stat().st_mtime > path.stat().st_mtime:
                newer.append(rel)
    for rel in target:
        if rel not in source:
            extra.append(rel)
    return differ, newer, extra


CORE_LUA = CORE / "lua"
CORE_HEADER = "-- Copied from ~/MODS/TraditionalPreservationCore/{source} by `tp sync`. Edit it there, not here.\n"


def core_copies(mod):
    """(source in TraditionalPreservationCore, copy in the mod, text the copy should hold) for every core module.

    lua/<side>/Core/X.lua goes to <mod>/42/media/lua/<side>/<mod>/Core/X.lua, required as "<mod>/Core/X".
    """
    copies = []
    for source in sorted(CORE_LUA.glob("*/Core/*.lua")):
        side = source.parent.parent.name
        copy = MODS / mod / "42" / "media" / "lua" / side / mod / "Core" / source.name
        text = CORE_HEADER.format(source=source.relative_to(CORE)) + source.read_text()
        copies.append((source, copy, text))
    return copies


def uses_core(mod):
    return any(copy.exists() for _, copy, _ in core_copies(mod))


def core_state(mod):
    """None if the mod doesn't use the core, else the copies that are missing or out of date."""
    if not uses_core(mod):
        return None
    return [copy for _, copy, text in core_copies(mod) if not copy.exists() or copy.read_text() != text]


def git_state(mod):
    root = MODS / mod
    if not (root / ".git").exists():
        return "no git"
    changed = subprocess.run(["git", "status", "--porcelain"], cwd=root, capture_output=True, text=True).stdout
    last = subprocess.run(["git", "log", "-1", "--format=%cd %s", "--date=short"], cwd=root,
                          capture_output=True, text=True).stdout.strip()
    count = len([line for line in changed.splitlines() if line.strip()])
    return (f"{count} uncommitted" if count else "clean") + f", last: {last}"


def guide_pairs():
    """(source guide, copy inside a mod) for every guide whose name matches a mod folder."""
    pairs = []
    for guide in sorted(list(COLLECTION.glob("*_Guide.md")) + list(GUIDES.glob("*_Guide.md"))):
        name = guide.stem[:-len("_Guide")].split("_", 1)[-1]
        for mod in (PREFIX + name, name):
            if (MODS / mod / "42" / "mod.info").exists():
                pairs.append((guide, MODS / mod / guide.name))
                break
    return pairs


def tiledefs():
    """{tiledef number: [mods using it]} from every mod.info in ~/MODS and the installed mods, each mod once."""
    numbers = {}
    for root in (MODS, INSTALLED):
        for info in sorted(root.glob("*/42/mod.info")):
            mod = info.parent.parent.name
            if mod.startswith("_") or mod.endswith("-old"):
                continue
            for match in re.finditer(r"^tiledef=\S+\s+(\d+)", info.read_text(errors="replace"), re.M):
                users = numbers.setdefault(int(match.group(1)), [])
                if mod not in users:
                    users.append(mod)
    return numbers


def cmd_status(_args):
    for number, users in sorted(tiledefs().items()):
        if len(users) > 1:
            print(f"WARNING: tiledef {number} is used by {', '.join(users)}")
    pairs = {copy.parent.name: (src, copy) for src, copy in guide_pairs()}
    for mod in all_mods():
        compared = compare_install(mod)
        if compared is None:
            installed = "not installed"
        else:
            differ, newer, extra = compared
            installed = "same" if not (differ or extra) else f"{len(differ)} differ"
            if newer:
                installed += f", {len(newer)} NEWER in the installed copy"
            if extra:
                installed += f", {len(extra)} only in the installed copy"
        guide = ""
        if mod in pairs:
            src, copy = pairs[mod]
            guide = "guide same" if copy.exists() and copy.read_bytes() == src.read_bytes() else "guide differs (tp guides)"
        stale = core_state(mod)
        core = "" if stale is None else ("; core synced" if not stale else f"; core: {len(stale)} out of date (tp sync)")
        print(f"{short(mod):<11} git: {git_state(mod)}\n{'':<11} installed: {installed}" + (f"; {guide}" if guide else "") + core)


def run_tests(mod):
    """Runs tests/*.lua from the mod folder. Returns True if every one passed."""
    root = MODS / mod
    tests = sorted((root / "tests").glob("*.lua"))
    env = dict(os.environ, TPCORE=str(CORE))
    ok = True
    stale = core_state(mod)
    if stale:
        ok = False
        print(f"  FAIL {short(mod)}: core out of date, run tp sync {short(mod)}: "
              + ", ".join(str(copy.relative_to(root)) for copy in stale))
    for test in tests:
        result = subprocess.run(["luajit", str(test.relative_to(root))], cwd=root, env=env,
                                capture_output=True, text=True, timeout=600)
        out = result.stdout + result.stderr
        passed = result.returncode == 0 and "all passed" in out
        checks = out.count("\nok ") + out.startswith("ok ")
        print(f"  {'ok  ' if passed else 'FAIL'} {short(mod)}/{test.name} ({checks} checks)")
        if not passed:
            ok = False
            print("\n".join("       " + line for line in out.strip().splitlines()[-8:]))
    if not tests:
        print(f"  --   {short(mod)}: no tests")
    return ok


def golden_config():
    path = GOLDEN_CONFIG
    return json.loads(path.read_text()) if path.exists() else {}


def run_golden(mod, update=False):
    """Runs the mod's recorded tools and compares their output. Returns True if all match."""
    ok = True
    for tool in golden_config().get(mod, []):
        root = MODS / mod
        record = GOLDEN / mod / (Path(tool).stem + ".txt")
        result = subprocess.run(["luajit", tool], cwd=root, capture_output=True, text=True, timeout=1800,
                                env=dict(os.environ, TPCORE=str(CORE)))
        out = result.stdout + result.stderr + f"exit={result.returncode}\n"
        if update or not record.exists():
            record.parent.mkdir(parents=True, exist_ok=True)
            record.write_text(out)
            print(f"  rec  {short(mod)}/{tool}")
        elif record.read_text() == out:
            print(f"  ok   {short(mod)}/{tool} matches its golden output")
        else:
            ok = False
            old, new = record.read_text().splitlines(), out.splitlines()
            changed = sum(1 for a, b in zip(old, new) if a != b) + abs(len(old) - len(new))
            print(f"  FAIL {short(mod)}/{tool}: {changed} lines differ from {record.relative_to(CORE)}")
    return ok


def run_core_tests():
    """The harness's own tests, run from TraditionalPreservationCore."""
    ok = True
    for test in sorted((CORE / "tests").glob("test_*.lua")):
        result = subprocess.run(["luajit", f"tests/{test.name}"], cwd=CORE, capture_output=True, text=True, timeout=600)
        out = result.stdout + result.stderr
        passed = result.returncode == 0 and "all passed" in out
        print(f"  {'ok  ' if passed else 'FAIL'} core/{test.name}")
        if not passed:
            ok = False
            print("\n".join("       " + line for line in out.strip().splitlines()[-8:]))
    return ok


def cmd_test(args):
    ok = run_core_tests() if not args else True
    for mod in resolve(args):
        ok = run_tests(mod) and ok
        ok = run_golden(mod) and ok
    print("all passed" if ok else "SOME FAILED")
    return 0 if ok else 1


def cmd_golden(args):
    update = "--update" in args
    ok = True
    for mod in resolve([a for a in args if not a.startswith("--")]):
        ok = run_golden(mod, update) and ok
    return 0 if ok else 1


def cmd_install(args):
    force, skip_tests = "--force" in args, "--skip-tests" in args
    names = [a for a in args if not a.startswith("--")]
    if not names:
        sys.exit("tp install: name a mod")
    for mod in resolve(names):
        if not skip_tests and not (run_tests(mod) and run_golden(mod)):
            sys.exit(f"tp install: {short(mod)} has failing tests, nothing installed")
        compared = compare_install(mod)
        if compared and not force:
            _, newer, extra = compared
            if newer or extra:
                for rel in newer:
                    print(f"  installed copy is newer: {rel}")
                for rel in extra:
                    print(f"  only in the installed copy: {rel}")
                sys.exit(f"tp install: {short(mod)} not installed. Bring those edits into ~/MODS/{mod} first, "
                         "or pass --force to overwrite them")
        target = INSTALLED / mod
        staging = INSTALLED / f".{mod}.new"
        if staging.exists():
            shutil.rmtree(staging)
        for rel, path in shipped_files(MODS / mod).items():
            (staging / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, staging / rel)  # keeps the time, so a later edit to the copy shows as newer
        if target.is_symlink():
            target.unlink()
        elif target.exists():
            shutil.rmtree(target)
        staging.rename(target)
        differ, newer, extra = compare_install(mod)
        if differ or extra:
            sys.exit(f"tp install: {short(mod)} copied but still differs: {len(differ)} files")
        print(f"installed {short(mod)} to {target}")
    return 0


def cmd_guides(args):
    force = "--force" in args
    blocked = []
    for src, copy in guide_pairs():
        if copy.exists() and copy.read_bytes() != src.read_bytes() and copy.stat().st_mtime > src.stat().st_mtime:
            blocked.append(copy)
    if blocked and not force:
        for copy in blocked:
            print(f"  edited inside the mod, newer than guides/: {copy.relative_to(MODS)}")
        sys.exit("tp guides: nothing copied. Move those edits into ~/MODS/guides first, or pass --force")
    for src, copy in guide_pairs():
        if not copy.exists() or copy.read_bytes() != src.read_bytes():
            shutil.copy2(src, copy)
            print(f"  copied {src.name} into {copy.parent.name}")
    archive = GUIDES / (COLLECTION.name + ".zip")
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as out:
        out.write(COLLECTION, COLLECTION.name)
        for guide in sorted(COLLECTION.glob("*.md")):
            out.write(guide, f"{COLLECTION.name}/{guide.name}")
    print(f"rebuilt {archive.relative_to(MODS)}")
    return 0


def cmd_sync(args):
    force = "--force" in args
    names = [a for a in args if not a.startswith("--")]
    mods = resolve(names) if names else [mod for mod in all_mods() if uses_core(mod)]
    if not mods:
        sys.exit("tp sync: no mod uses the core yet. Name one: tp sync <MOD>")
    blocked = []
    for mod in mods:
        for source, copy, text in core_copies(mod):
            if copy.exists() and copy.read_text() != text and copy.stat().st_mtime > source.stat().st_mtime:
                blocked.append(copy)
    if blocked and not force:
        for copy in blocked:
            print(f"  edited inside the mod, newer than TraditionalPreservationCore: {copy.relative_to(MODS)}")
        sys.exit("tp sync: nothing copied. Move those edits into ~/MODS/TraditionalPreservationCore/lua first, or pass --force")
    for mod in mods:
        changed = 0
        for _, copy, text in core_copies(mod):
            if not copy.exists() or copy.read_text() != text:
                copy.parent.mkdir(parents=True, exist_ok=True)
                copy.write_text(text)
                changed += 1
        print(f"  {short(mod)}: {changed} core files copied" if changed else f"  {short(mod)}: core up to date")
    return 0


TEMPLATE = CORE / "template"


def console_names():
    """The Dev console tables the mods already use (TPS, TPF, ...)."""
    names = set()
    for dev in MODS.glob("*/42/media/lua/client/*Dev.lua"):
        names.update(re.findall(r"^(TP[A-Z]+) = ", dev.read_text(errors="replace"), re.M))
    return names


def render(text, tokens):
    for token, value in tokens:  # longest first, so __STATION__ can't eat __STATION_ID__
        text = text.replace(token, value)
    return text


def cmd_new(args):
    options, names = {}, []
    rest = iter(args)
    for arg in rest:
        if arg in ("--station", "--short"):
            options[arg] = next(rest, None) or sys.exit(f"tp new: {arg} needs a value")
        else:
            names.append(arg)
    if len(names) != 1 or not re.fullmatch(r"[A-Z][A-Za-z0-9]+", names[0]):
        sys.exit("tp new: give one name in CamelCase, e.g. tp new Dairy")
    name = names[0]
    mod = PREFIX + name
    if (MODS / mod).exists():
        sys.exit(f"tp new: ~/MODS/{mod} already exists")

    station = options.get("--station", f"{name} Workbench")
    words = station.split()
    if len(words) < 2 or not all(re.fullmatch(r"[A-Z][A-Za-z]*", word) for word in words):
        sys.exit("tp new: the station needs two or more capitalised words, e.g. --station \"Cheese Press\" "
                 "(the engine names a moveable by its GroupName and CustomName)")

    taken = console_names()
    short_name = options.get("--short")
    if short_name is None:
        short_name = next((c for c in ("TP" + name[0].upper(), "TP" + name[:2].upper()) if c not in taken), None)
        if short_name is None:
            sys.exit("tp new: no free console name, pass --short TPX")
    if not re.fullmatch(r"TP[A-Z]+", short_name) or short_name in taken:
        sys.exit(f"tp new: console name {short_name} is taken or not TP<CAPITALS>. Taken: {', '.join(sorted(taken))}")

    tiledef = max(tiledefs(), default=5126) + 1
    numbers = [int(g.name.split("_", 1)[0]) for g in COLLECTION.glob("*_*_Guide.md") if g.name.split("_", 1)[0].isdigit()]
    guide = COLLECTION / f"{max(numbers, default=0) + 1}_{name}_Guide.md"

    tokens = [
        ("__STATION_TAG__", "".join(words)),
        ("__STATION_ID__", "_".join(words)),
        ("__STATION__", station),
        ("__GROUP__", " ".join(words[:-1])),
        ("__CUSTOM__", words[-1]),
        ("__TILEDEF__", str(tiledef)),
        ("__LOWER__", mod.lower()),
        ("__UPPER__", name.upper()),
        ("__SHORT__", short_name),
        ("__DATE__", datetime.date.today().isoformat()),
        ("__MOD__", mod),
        ("__NAME__", name),
    ]
    root = MODS / mod
    for source in sorted(TEMPLATE.rglob("*")):
        rel = source.relative_to(TEMPLATE)
        # .gitignore goes into the new repo; only caches are left behind.
        if not source.is_file() or rel.parts[0] == "guide" or "__pycache__" in rel.parts or source.suffix in SKIP_SUFFIXES:
            continue
        target = root / render(str(rel), tokens)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(render(source.read_text(), tokens))
    for script in (root / "tools").glob("*.py"):
        script.chmod(0o755)
    print(f"created ~/MODS/{mod}: station {station}, console {short_name}, tiledef {tiledef}")

    cmd_sync([mod])
    env = dict(os.environ, TPCORE=str(CORE))
    subprocess.run([sys.executable, "tools/build_tileset.py"], cwd=root, env=env, check=True)

    guide.parent.mkdir(parents=True, exist_ok=True)
    guide.write_text(render((TEMPLATE / "guide" / "Guide.md").read_text(), tokens))
    shutil.copy2(guide, root / guide.name)
    print(f"  guide stub {guide.relative_to(MODS)}, copied into the mod")

    config = golden_config()
    config[mod] = ["tools/season_report.lua"]
    GOLDEN_CONFIG.write_text(json.dumps(dict(sorted(config.items())), indent=2) + "\n")
    run_golden(mod)

    subprocess.run(["git", "init", "-q", "-b", "master"], cwd=root, check=True)
    ok = run_tests(mod)
    print(f"""
next:
  1. Settle the design questions in TraditionalPreservationCore/SERIES.md, then replace every TEMPLATE mark (grep -rn TEMPLATE {mod}).
  2. tp install {short(mod)}, restart the game, build the {station}, {short_name}.batches(4), Craft, {short_name}.age(72).
  3. Commit: the new repo ({mod}), and TraditionalPreservationCore (golden.json, golden/{mod}) and guides/.
  4. Add the mod to SERIES.md's table.""")
    return 0 if ok else 1


COMMANDS = {"status": cmd_status, "test": cmd_test, "golden": cmd_golden, "install": cmd_install, "guides": cmd_guides,
            "sync": cmd_sync, "new": cmd_new}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__)
        return 1
    return COMMANDS[sys.argv[1]](sys.argv[2:]) or 0


if __name__ == "__main__":
    sys.exit(main())
